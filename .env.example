# =========================================================
#  Modelo de variaveis de ambiente para qualquer projeto
#  Passo 1: copie este arquivo para `.env`
#  Passo 2: preencha com os valores do SEU ambiente
#  NUNCA envie o `.env` para o repositorio (esta no .gitignore)
# =========================================================

# --- Projeto / caminhos ------------------------------------
PROJETO_NOME=
PASTA_RAIZ=.
PASTA_DADOS_RAW=data/raw
PASTA_DADOS_PROCESSED=data/processed
PASTA_DADOS_DESCARTADOS=data/descartados
PASTA_NOTEBOOKS=notebooks
PASTA_SAIDAS=saidas

# --- Banco de dados (SQL) -----------------------------------
# SQLite (padrao, sem servidor):
DB_URL=sqlite:///data/estudos.db
# PostgreSQL (exemplo):
# DB_URL=postgresql://usuario:senha@localhost:5432/nome_do_banco
DB_ECHO=false

# --- Execucao / qualidade -----------------------------------
LOG_NIVEL=INFO
SEMENTE_ALEATORIA=42

# --- GitHub (perfil-adaptativo) ------------------------------
# Token para consultar a API do GitHub com limite maior de requisicoes e,
# se voce quiser, para publicar depois das duas aprovacoes.
# Sem token o gerador tambem funciona (limite publico de 60 consultas/hora)
# e o modo --offline funciona sem rede nenhuma.
# A publicacao usa GITHUB_TOKEN do ambiente; sem ele, 'publicar' recusa.
# NUNCA preencha estes valores aqui: o arquivo .env.example e versionado.
GITHUB_TOKEN=
GH_TOKEN=

# --- APIs externas (opcional) -------------------------------
# O VALOR de chave NAO vai neste arquivo nem em nenhum arquivo versionado.
# Ele vive na variavel de ambiente do usuario do Windows:
#   ... \scripts\segredos.ps1 -Definir DEEPSEEK_API_KEY
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# HF_TOKEN=
